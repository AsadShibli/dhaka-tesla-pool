# Local demo defaults. Copy to .env. Do not put real secrets here.
POSTGRES_USER=tesla
POSTGRES_PASSWORD=tesla
POSTGRES_DB=tesla_pool
DATABASE_URL=postgres://tesla:tesla@localhost:5432/tesla_pool
API_PORT=4000
# Signs the login cookie. Replace this outside a local demo.
JWT_SECRET=dev-only-change-me
# Next.js server reads this when it calls the API.
API_URL=http://localhost:4000
