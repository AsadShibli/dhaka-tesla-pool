# Local demo defaults. Copy to .env to change them. Do not put real secrets here.
POSTGRES_USER=tesla
POSTGRES_PASSWORD=tesla
POSTGRES_DB=tesla_pool
# Host port for Postgres. 5433 avoids a Postgres already installed on 5432.
DB_HOST_PORT=5433
# Used when the API runs outside Docker (npm run dev in apps/api).
DATABASE_URL=postgres://tesla:tesla@localhost:5433/tesla_pool
API_PORT=4000
# Signs the login cookie. Replace this outside a local demo.
JWT_SECRET=dev-only-change-me
# Next.js server reads this when it calls the API.
API_URL=http://localhost:4000
# Set to true to create the tables without the Jashim / Nusrat / Rafiq / Shirin cast.
SKIP_SEED=false
